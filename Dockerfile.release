# syntax=docker/dockerfile:1.7
# Release image: expects prebuilt binaries from CI (see .github/workflows/docker.yml)
#   dist/compira-mcp-linux-amd64
#   dist/compira-mcp-linux-arm64
#   dist/static/   (Admin UI)
FROM debian:bookworm-slim
ARG TARGETARCH
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates \
      git \
    && rm -rf /var/lib/apt/lists/*

COPY --chmod=755 dist/compira-mcp-linux-${TARGETARCH} /app/compira-mcp
COPY dist/static /app/static

ENV COMPIRA_STATIC_DIR=/app/static \
    COMPIRA_DATA_DIR=/app/data \
    COMPIRA_HOST=0.0.0.0 \
    COMPIRA_PORT=8080 \
    RUST_LOG=info,compira_mcp=info

EXPOSE 8080
VOLUME ["/app/data"]
CMD ["/app/compira-mcp"]
